<mujoco model="dash">
  <!--
    18 DOF: 5 per leg (hip yaw/roll/pitch, knee pitch, ankle pitch) and 4 per
    arm (shoulder pitch/roll/yaw, elbow pitch).

    Derived from DASH_URDF/mjmodel.xml, with the box foot colliders taken from
    the 20-DOF variant since the 18-DOF export ships visual
    meshes only.

    Changes made for mjlab:
      - Split visual and collision geometry into `visual` / `collision` default
        classes, and named every collider `*_collision` so mjlab's CollisionCfg
        and contact sensors can target them by regex.
      - Added `l_foot` / `r_foot` sites for foot-clearance and foot-slip rewards
        and for the per-foot terrain height scan.
      - Added the IMU site and sensor block mjlab's tasks read by name.
      - Meshes decimated to ~8k faces (see scripts/decimate_meshes.py).
  -->
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <default>
    <default class="dash">
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0" density="0"/>
      </default>
      <default class="collision">
        <geom group="3" contype="1" conaffinity="1" density="0"/>
      </default>
    </default>
  </default>

