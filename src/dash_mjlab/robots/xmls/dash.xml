  <!-- The hip and upper-leg capsules overlap by ~11 mm at the nominal pose, and
       every other pose: they are adjacent links padded to meet across the
       intervening dist_hip. MuJoCo only auto-excludes parent-child pairs, so
       this grandparent-grandchild pair is not filtered, and the `self_collision`
       sensor reports a permanent contact on both legs.

       Left in, it costs -0.95/step against +0.06/step of tracking reward, which
       makes the whole episode net-negative and teaches the policy to terminate
       as fast as possible rather than to walk. Excluding the pair is the fix
       rather than shrinking the capsules, which would open a real gap at the
       hip that other contacts should still see. -->
  <contact>
    <exclude body1="r_hip" body2="r_upper_leg"/>
    <exclude body1="l_hip" body2="l_upper_leg"/>
  </contact>

  <!-- mjlab's velocity and tracking tasks read these by name: base_lin_vel and
       base_ang_vel observations, the upright reward, and the angular momentum
       penalty. Renaming any of them breaks those terms. -->
  <sensor>
    <gyro name="imu_ang_vel" site="imu_in_torso"/>
    <velocimeter name="imu_lin_vel" site="imu_in_torso"/>
    <accelerometer name="imu_lin_acc" site="imu_in_torso"/>
    <framezaxis name="imu_upvector" objtype="body" objname="world" reftype="site" refname="imu_in_torso"/>
    <subtreeangmom name="root_angmom" body="torso"/>
  </sensor>
</mujoco>
